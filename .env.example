# ---------------------------------------------------------------------------
# Pick The Bank · Kundenportal – Beispielkonfiguration
# Diese Datei enthält KEINE echten Zugangsdaten. Kopieren Sie sie nach .env
# und tragen Sie dort Ihre Werte ein. .env gehört nicht ins Repository.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Datenbank (cPanel: Benutzer und Datenbank tragen meist ein Kontopräfix)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cpaneluser_portal
DB_PASSWORD=
DB_NAME=cpaneluser_pickbank
DB_POOL_SIZE=10
DB_SSL=false

# Sitzungen
SESSION_COOKIE_NAME=ptb_session
CSRF_COOKIE_NAME=ptb_csrf
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_MINUTES=15

# Sicherheit
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Kommagetrennte Liste erlaubter Herkünfte für schreibende Anfragen
ALLOWED_ORIGINS=https://portal.pickbank.de

# Dateiablage (Kundendokumente, Banklogos)
# Verzeichnis ausserhalb des Webroots – unter cPanel z. B. /home/cpaneluser/ptb-storage
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10
MAX_LOGO_MB=2

# Ersteinrichtung des Administrators (pnpm seed:admin)
ADMIN_EMAIL=admin@pickbank.de
ADMIN_NAME=Pick The Bank Administration
# Ohne ADMIN_PASSWORD erzeugt das Skript ein Passwort und zeigt es einmalig an
ADMIN_PASSWORD=
